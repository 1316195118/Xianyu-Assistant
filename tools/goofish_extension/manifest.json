{
  "manifest_version": 3,
  "name": "鱼助手 · 闲鱼登录同步",
  "version": "1.2.1",
  "description": "后台续期并自动同步当前浏览器的闲鱼登录态到你自己指定的鱼助手，不上传第三方。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.goofish.com/*",
    "*://*.taobao.com/*",
    "*://*.tmall.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "鱼助手 · 闲鱼登录同步",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
